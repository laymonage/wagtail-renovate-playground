{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:recommended",
    ":enablePreCommit",
    "helpers:pinGitHubActionDigests",
  ],

  // Run weekly.
  "schedule": ["before 6am on monday"],
  "timezone": "Etc/UTC",
  "prConcurrentLimit": 10,

  "labels": ["dependencies", "Infrastructure", "type:Cleanup/Optimisation"],

  "minimumReleaseAge": "7 days",

  // Periodically refresh uv.lock to catch transitive dependency updates.
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"],
  },

  "packageRules": [
    // Runtime dependencies in [project.dependencies] are user-facing.
    // Constraint changes propagate to everyone who installs Wagtail, so
    // they remain deliberate release-planning decisions, never automated.
    // No per-dep PRs here, the lockfile that CI and local dev environments
    // use is kept current via lockFileMaintenance above.
    {
      "matchManagers": ["pep621"],
      "matchDepTypes": ["project.dependencies"],
      "enabled": false,
    },

    // Testing and docs extras only affect contributors, not end users.
    // Safe to bump floors so contributor tooling stays current.
    {
      "matchManagers": ["pep621"],
      "matchDepTypes": [
        "project.optional-dependencies.testing",
        "project.optional-dependencies.docs",
      ],
      "rangeStrategy": "bump",
    },

    // Group linter and formatter updates into a single PR. Regex patterns
    // (delimited by `/`) catch both the pep621 dep (e.g. "ruff") and any
    // related pre-commit hook (e.g. the repo URL "astral-sh/ruff-pre-commit"),
    // so a single rule handles both managers.
    {
      "matchPackageNames": [
        "/ruff/",
        "/doc8/",
        "/semgrep/",
        "/curlylint/",
        "/djhtml/",
      ],
      "groupName": "Python linters and formatters dependencies",
    },

    // Group any frontend dependencies that have no other grouping rule into one.
    {
      "matchManagers": ["npm"],
      "enabled": true,
      "groupName": "Build tool dependencies",
    },

    // Group dependencies by runtime, storybook, testing, and linting/formatting.
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "enabled": true,
      "groupName": "Node.js runtime dependencies",
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["/storybook/"],
      "enabled": true,
      "groupName": "Storybook dependencies",
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["/enzyme/", "/jest/", "/test/", "/mock/"],
      "enabled": true,
      "groupName": "Testing dependencies",
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["/prettier/", "/eslint/", "/stylelint/"],
      "enabled": true,
      "groupName": "Front-end linters and formatters dependencies",
    },

    // Group all dependency updates inside the project template (its
    // requirements.txt and Dockerfile) into a single PR.
    {
      "matchFileNames": ["wagtail/project_template/**"],
      "groupName": "Project template dependencies",
    },

    // Group all CI updates (GitHub Actions + CircleCI) into a single PR.
    {
      "matchCategories": ["ci"],
      "groupName": "CI configuration dependencies",
    },
  ],
}
